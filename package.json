{
  "name": "echoquest",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Speak the spell, beat the monster. A pixel-art English word adventure for kids and families.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
