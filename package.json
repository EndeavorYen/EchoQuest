    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vp-tw/cjk-web-fonts-fusion-pixel-font": "0.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
